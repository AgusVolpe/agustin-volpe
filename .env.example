# Variables de conexión a la planta (red planta-lan)
SISTEMA_NOMBRE=agustin-volpe
MQTT_HOST=broker
MQTT_PORT=1883
SIM_URL=http://sim:8100

# Proxy de salida de la planta hacia internet (se mapea a HTTP_PROXY/HTTPS_PROXY dentro del contenedor)
PLANTA_HTTP_PROXY=http://enlace:3128
PLANTA_HTTPS_PROXY=http://enlace:3128
PLANTA_NO_PROXY=broker,sim,localhost,127.0.0.1,postgres,ollama,mcp,host.docker.internal,enlace

# Base de datos PostgreSQL + pgvector
POSTGRES_USER=planta
POSTGRES_PASSWORD=planta_secret
POSTGRES_DB=planta_db
DATABASE_URL=postgresql+psycopg://planta:planta_secret@postgres:5432/planta_db

# Modelos locales (Ollama en contenedor / STT faster-whisper)
OLLAMA_BASE_URL=http://ollama:11434
LLM_LOCAL_MODEL=qwen2.5:3b
WHISPER_MODEL_SIZE=small

# Modelos en la nube (NVIDIA NIM - para Entrega 2: visión multimodal)
NVIDIA_API_KEY=tu_api_key_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_MODEL=google/gemma-4-31b-it
VLM_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TIMEOUT_S=25
API_UI_PORT=8090
