# Variables de conexión a la planta (red planta-lan)
SISTEMA_NOMBRE=agustin-volpe
MQTT_HOST=broker
MQTT_PORT=1883
SIM_URL=http://sim:8100

# Proxy de salida de la planta hacia internet
HTTP_PROXY=http://enlace:3128
HTTPS_PROXY=http://enlace:3128
NO_PROXY=broker,sim,localhost,127.0.0.1,postgres,ollama,mcp

# Base de datos PostgreSQL + pgvector
POSTGRES_USER=planta
POSTGRES_PASSWORD=planta_secret
POSTGRES_DB=planta_db
DATABASE_URL=postgresql+psycopg://planta:planta_secret@postgres:5432/planta_db

# Modelos locales (Ollama / STT)
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_LOCAL_MODEL=ministral-3:3b
WHISPER_MODEL_SIZE=small

# Modelos en la nube (NVIDIA NIM - para Entrega 2)
NVIDIA_API_KEY=tu_api_key_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
